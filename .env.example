BOT_TOKEN=123456789:replace_with_real_telegram_bot_token
APP_URL=https://your-public-domain.example
WEBHOOK_SECRET_TOKEN=replace_with_strong_random_secret
START_MESSAGE=Bot is online.
WEBHOOK_PATH=/webhook
DROP_PENDING_UPDATES_ON_STARTUP=false
DELETE_WEBHOOK_BEFORE_SET=true
DELETE_WEBHOOK_ON_SHUTDOWN=false
SYNC_WEBHOOK_ON_STARTUP=true
LOG_LEVEL=INFO
SERVICE_NAME=telegram-status-bot
ENVIRONMENT=production
